[{"deleteText":{"objectId":"pi_simple_20261022_s01_original_003","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s01_original_003","insertionIndex":0,"text":"How can robots adapt existing skills\nto unfamiliar physical conditions?"}},{"deleteText":{"objectId":"pi_simple_20261022_s01_original_004","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s01_original_004","insertionIndex":0,"text":"Build and refine physical understanding through interaction."}},{"deleteText":{"objectId":"pi_simple_20261022_s01_original_013","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s01_original_013","insertionIndex":0,"text":"A policy that can grasp and move\nacross variations of the same task."}},{"deleteText":{"objectId":"pi_simple_20261022_s01_original_075","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s01_original_075","insertionIndex":0,"text":"Physical understanding"}},{"deleteText":{"objectId":"pi_simple_20261022_s01_original_076","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s01_original_076","insertionIndex":0,"text":"Estimate relevant properties.\nRefine them from observed outcomes."}},{"deleteText":{"objectId":"pi_simple_20261022_s01_original_091","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s01_original_091","insertionIndex":0,"text":"Research focus: learning from interaction, including failures and unexpected responses."}},{"deleteText":{"objectId":"pi_simple_20261022_s02_original_094","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s02_original_094","insertionIndex":0,"text":"Enabling policy: state + physical context"}},{"deleteText":{"objectId":"pi_simple_20261022_s02_original_095","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s02_original_095","insertionIndex":0,"text":"Train across physical conditions so the policy can use\nenvironmental estimates to adapt its actions."}},{"deleteText":{"objectId":"pi_simple_20261022_s02_original_104","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s02_original_104","insertionIndex":0,"text":"Known during training\nEstimated during deployment\nExamples: mass, friction"}},{"updatePageElementTransform":{"objectId":"pi_simple_20261022_s02_original_104","applyMode":"ABSOLUTE","transform":{"scaleX":1.038225,"scaleY":0.2667,"translateX":41.85,"translateY":256.95,"unit":"PT"}}},{"deleteText":{"objectId":"pi_simple_20261022_s02_original_146","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s02_original_146","insertionIndex":0,"text":"Enabling assumption: the policy can perform the required behavior under the tested conditions."}},{"updateTextStyle":{"objectId":"pi_simple_20261022_s02_original_146","textRange":{"type":"ALL"},"style":{"fontFamily":"Arial","fontSize":{"magnitude":12,"unit":"PT"},"bold":false,"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.3843137254901961,"green":0.4549019607843137,"blue":0.47843137254901963}}}},"fields":"fontFamily,fontSize,bold,foregroundColor,link"}},{"updateParagraphStyle":{"objectId":"pi_simple_20261022_s02_original_146","textRange":{"type":"ALL"},"style":{"alignment":"START","lineSpacing":110,"spaceAbove":{"magnitude":0,"unit":"PT"},"spaceBelow":{"magnitude":5,"unit":"PT"},"indentStart":{"magnitude":0,"unit":"PT"},"indentEnd":{"magnitude":0,"unit":"PT"},"indentFirstLine":{"magnitude":0,"unit":"PT"}},"fields":"alignment,lineSpacing,spaceAbove,spaceBelow,indentStart,indentEnd,indentFirstLine"}},{"deleteText":{"objectId":"pi_simple_20261022_s03_original_150","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s03_original_150","insertionIndex":0,"text":"Initial visual mass estimation"}},{"deleteText":{"objectId":"pi_simple_20261022_s03_original_151","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s03_original_151","insertionIndex":0,"text":"Completed baseline: predict mass from an initial RGB image.\nCubes vary in size; material and density are fixed."}},{"deleteText":{"objectId":"pi_simple_20261022_s03_original_158","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s03_original_158","insertionIndex":0,"text":"Held-out error"}},{"updateShapeProperties":{"objectId":"pi_simple_20261022_s03_original_155","shapeProperties":{"shapeBackgroundFill":{"propertyState":"NOT_RENDERED"},"outline":{"propertyState":"NOT_RENDERED"}},"fields":"shapeBackgroundFill,outline"}},{"deleteObject":{"objectId":"pi_simple_20261022_s03_original_166"}},{"deleteText":{"objectId":"pi_simple_20261022_s04_original_169","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s04_original_169","insertionIndex":0,"text":"Current pipeline in simulation"}},{"deleteText":{"objectId":"pi_simple_20261022_s04_original_170","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_simple_20261022_s04_original_170","insertionIndex":0,"text":"One initial image supplies mass to the policy; execution uses state and force feedback."}},{"deleteText":{"objectId":"pi_pipeline_v2_text_051","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_pipeline_v2_text_051","insertionIndex":0,"text":"Current implementation: the estimate and model weights stay fixed throughout execution."}},{"deleteText":{"objectId":"pi_next_steps_20261022_exemplar_00","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_next_steps_20261022_exemplar_00","insertionIndex":0,"text":"Next: refine understanding through interaction"}},{"deleteText":{"objectId":"pi_next_steps_20261022_exemplar_01","textRange":{"type":"ALL"}}},{"insertText":{"objectId":"pi_next_steps_20261022_exemplar_01","insertionIndex":0,"text":"Proposed: use execution outcomes to improve task-relevant physical estimates."}},{"createShape":{"objectId":"pi_reframe_known_title","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"pi_next_steps_20261022","size":{"width":{"magnitude":304.4,"unit":"PT"},"height":{"magnitude":41.4,"unit":"PT"}},"transform":{"scaleX":1,"scaleY":1,"translateX":41.8,"translateY":227.8,"unit":"PT"}}}},{"insertText":{"objectId":"pi_reframe_known_title","insertionIndex":0,"text":"First: refine known factors"}},{"updateTextStyle":{"objectId":"pi_reframe_known_title","textRange":{"type":"ALL"},"style":{"fontFamily":"Arial","fontSize":{"magnitude":16.65,"unit":"PT"},"bold":true,"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.09411764705882353,"green":0.19215686274509805,"blue":0.2235294117647059}}}},"fields":"fontFamily,fontSize,bold,foregroundColor,link"}},{"updateParagraphStyle":{"objectId":"pi_reframe_known_title","textRange":{"type":"ALL"},"style":{"alignment":"START","lineSpacing":110,"spaceAbove":{"magnitude":0,"unit":"PT"},"spaceBelow":{"magnitude":5,"unit":"PT"},"indentStart":{"magnitude":0,"unit":"PT"},"indentEnd":{"magnitude":0,"unit":"PT"},"indentFirstLine":{"magnitude":0,"unit":"PT"}},"fields":"alignment,lineSpacing,spaceAbove,spaceBelow,indentStart,indentEnd,indentFirstLine"}},{"createShape":{"objectId":"pi_reframe_known_body","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"pi_next_steps_20261022","size":{"width":{"magnitude":304.4,"unit":"PT"},"height":{"magnitude":72.4,"unit":"PT"}},"transform":{"scaleX":1,"scaleY":1,"translateX":41.8,"translateY":266.8,"unit":"PT"}}}},{"insertText":{"objectId":"pi_reframe_known_body","insertionIndex":0,"text":"Use interaction to correct estimates\nof properties such as mass and friction."}},{"updateTextStyle":{"objectId":"pi_reframe_known_body","textRange":{"type":"ALL"},"style":{"fontFamily":"Arial","fontSize":{"magnitude":14.4,"unit":"PT"},"bold":false,"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.09411764705882353,"green":0.19215686274509805,"blue":0.2235294117647059}}}},"fields":"fontFamily,fontSize,bold,foregroundColor,link"}},{"updateParagraphStyle":{"objectId":"pi_reframe_known_body","textRange":{"type":"ALL"},"style":{"a