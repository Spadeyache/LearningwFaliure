ates\ncannot explain the observed outcome."}},{"updateTextStyle":{"objectId":"pi_reframe_unknown_body","textRange":{"type":"ALL"},"style":{"fontFamily":"Arial","fontSize":{"magnitude":14.4,"unit":"PT"},"bold":false,"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.09411764705882353,"green":0.19215686274509805,"blue":0.2235294117647059}}}},"fields":"fontFamily,fontSize,bold,foregroundColor,link"}},{"updateParagraphStyle":{"objectId":"pi_reframe_unknown_body","textRange":{"type":"ALL"},"style":{"alignment":"START","lineSpacing":110,"spaceAbove":{"magnitude":0,"unit":"PT"},"spaceBelow":{"magnitude":5,"unit":"PT"},"indentStart":{"magnitude":0,"unit":"PT"},"indentEnd":{"magnitude":0,"unit":"PT"},"indentFirstLine":{"magnitude":0,"unit":"PT"}},"fields":"alignment,lineSpacing,spaceAbove,spaceBelow,indentStart,indentEnd,indentFirstLine"}},{"createShape":{"objectId":"pi_reframe_open_question","shapeType":"TEXT_BOX","elementProperties":{"pageObjectId":"pi_next_steps_20261022","size":{"width":{"magnitude":662.4,"unit":"PT"},"height":{"magnitude":40.4,"unit":"PT"}},"transform":{"scaleX":1,"scaleY":1,"translateX":28.8,"translateY":347.8,"unit":"PT"}}}},{"insertText":{"objectId":"pi_reframe_open_question","insertionIndex":0,"text":"Open question: what evidence should trigger an update, and what should change?"}},{"updateTextStyle":{"objectId":"pi_reframe_open_question","textRange":{"type":"ALL"},"style":{"fontFamily":"Arial","fontSize":{"magnitude":13.5,"unit":"PT"},"bold":false,"foregroundColor":{"opaqueColor":{"rgbColor":{"red":0.09411764705882353,"green":0.19215686274509805,"blue":0.2235294117647059}}}},"fields":"fontFamily,fontSize,bold,foregroundColor,link"}},{"updateParagraphStyle":{"objectId":"pi_reframe_open_question","textRange":{"type":"ALL"},"style":{"alignment":"START","lineSpacing":110,"spaceAbove":{"magnitude":0,"unit":"PT"},"spaceBelow":{"magnitude":5,"unit":"PT"},"indentStart":{"magnitude":0,"unit":"PT"},"indentEnd":{"magnitude":0,"unit":"PT"},"indentFirstLine"